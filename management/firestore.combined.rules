rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userPath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.token.email);
    }

    function userExists(appId) {
      return signedIn() && exists(userPath(appId));
    }

    function userData(appId) {
      return get(userPath(appId)).data;
    }

    function isSuperAdmin(appId) {
      return signedIn() && (
        request.auth.token.email == 'admin@brave.com' ||
        request.auth.token.email == 'jehad234kawash@yahoo.com' ||
        (userExists(appId) && userData(appId).get('isSuper', false) == true)
      );
    }

    function hasPermission(appId, permission) {
      return isSuperAdmin(appId) ||
        (userExists(appId) && userData(appId).get('permissions', []).hasAny([permission]));
    }

    function staffBranch(appId) {
      return userExists(appId) ? userData(appId).get('branch', '') : '';
    }

    function canUseBranch(appId, branch) {
      return isSuperAdmin(appId) ||
        (signedIn() && (
          (branch == 'شفا بدران' && request.auth.token.email == 'shafa@brave.com') ||
          (branch == 'أبو نصير' && request.auth.token.email in ['abunseir@brave.com', 'nseir@brave.com']) ||
          staffBranch(appId) == branch
        ));
    }

    function validBranch(branch) {
      return branch in ['شفا بدران', 'أبو نصير', 'الكل', 'مشترك', 'الفرع الرئيسي'];
    }

    function isFamily() {
      return request.auth != null && request.auth.token.role == 'family';
    }

    function ownsStudent(appId, studentId) {
      return isFamily() &&
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/students/$(studentId)).data.familyUid == request.auth.uid;
    }

    function canCreateInBranch(appId) {
      return request.resource.data.branch is string &&
        validBranch(request.resource.data.branch) &&
        canUseBranch(appId, request.resource.data.branch);
    }

    function canChangeInBranch(appId) {
      return resource.data.branch is string &&
        request.resource.data.branch == resource.data.branch &&
        canUseBranch(appId, resource.data.branch);
    }

    function canDeleteInBranch(appId) {
      return resource.data.branch is string && canUseBranch(appId, resource.data.branch);
    }

    // Staff profiles. A staff member may read only their own profile.
    match /artifacts/{appId}/public/data/users/{userEmail} {
      allow read: if signedIn() &&
        (request.auth.token.email == userEmail || isSuperAdmin(appId));
      allow create, update, delete: if isSuperAdmin(appId);
    }

    // Public registration form: create-only, with a strict shape and size limits.
    match /artifacts/{appId}/public/data/registrations/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'dob', 'address', 'branch', 'status', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20 &&
        request.resource.data.dob is string && request.resource.data.dob.size() <= 20 &&
        request.resource.data.address is string && request.resource.data.address.size() <= 250 &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() <= 40 &&
        request.resource.data.branch in ['شفا بدران', 'أبو نصير'];
      allow read: if hasPermission(appId, 'registrations');
      allow update: if hasPermission(appId, 'registrations') && canChangeInBranch(appId);
      allow delete: if hasPermission(appId, 'registrations') && canDeleteInBranch(appId);
    }

    // Public recovery request. The public may create but can never list requests.
    match /artifacts/{appId}/public/data/password_reset_requests/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(['studentName', 'phone', 'status', 'createdAt']) &&
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() >= 3 && request.resource.data.studentName.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20 &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if hasPermission(appId, 'password_resets');
    }

    // A signed-in family may register multiple devices for its own students.
    match /artifacts/{appId}/public/data/device_tokens/{tokenId} {
      allow create, update: if
        ownsStudent(appId, request.resource.data.studentId) &&
        request.resource.data.keys().hasOnly(['studentId', 'token', 'platform', 'updatedAt']) &&
        request.resource.data.studentId is string &&
        request.resource.data.studentId.size() >= 1 && request.resource.data.studentId.size() <= 128 &&
        request.resource.data.token is string &&
        request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 4096 &&
        request.resource.data.platform in ['android', 'ios'] &&
        request.resource.data.updatedAt == request.time;
      allow read, delete: if false;
    }

    match /artifacts/{appId}/public/data/students/{docId} {
      allow read: if
        (isFamily() && resource.data.familyUid == request.auth.uid) ||
        isSuperAdmin(appId) ||
        (userExists(appId) && canUseBranch(appId, resource.data.branch) &&
          userData(appId).get('permissions', []).hasAny([
            'students', 'attendance', 'subscriptions', 'finance', 'tests',
            'student_notes', 'dashboard', 'reports', 'archive'
          ]));
      allow create: if hasPermission(appId, 'students') && canCreateInBranch(appId);
      allow delete: if hasPermission(appId, 'students') && canDeleteInBranch(appId);
      allow update: if signedIn() && canChangeInBranch(appId) && (
        hasPermission(appId, 'students') ||
        (hasPermission(appId, 'attendance') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'attendance', 'customOrder', 'group'
          ])) ||
        (hasPermission(appId, 'subscriptions') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subEnd', 'status'])) ||
        (hasPermission(appId, 'finance') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subEnd', 'status'])) ||
        (hasPermission(appId, 'tests') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'belt', 'lastTestDate', 'nextTestDate'
          ])) ||
        (hasPermission(appId, 'student_notes') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'internalNotes', 'note'])) ||
        (hasPermission(appId, 'password_resets') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'password', 'isPasswordHashed', 'passwordResetAt'
          ]))
      );
    }

    // Public content.
    match /artifacts/{appId}/public/data/news/{docId} {
      allow read: if true;
      allow create: if hasPermission(appId, 'news') && canCreateInBranch(appId);
      allow update: if hasPermission(appId, 'news') && canChangeInBranch(appId);
      allow delete: if hasPermission(appId, 'news') && canDeleteInBranch(appId);
    }

    match /artifacts/{appId}/public/data/schedule/{docId} {
      allow read: if true;
      allow create: if hasPermission(appId, 'schedule') && canCreateInBranch(appId);
      allow update: if hasPermission(appId, 'schedule') && canChangeInBranch(appId);
      allow delete: if hasPermission(appId, 'schedule') && canDeleteInBranch(appId);
    }

    // Legacy administrative notes are no longer writable by the public.
    match /artifacts/{appId}/public/data/admin_notes/{docId} {
      // Temporary compatibility for the currently deployed forgot-password form.
      // Remove this public create path after the new frontend is deployed.
      allow create: if
        request.resource.data.keys().hasOnly([
          'text', 'type', 'transactionType', 'date', 'monthKey',
          'createdAt', 'isUrgent'
        ]) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 500 &&
        request.resource.data.type == 'note' &&
        request.resource.data.transactionType == 'expense' &&
        request.resource.data.date is string && request.resource.data.date.size() <= 20 &&
        request.resource.data.monthKey is string && request.resource.data.monthKey.size() <= 20 &&
        request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40 &&
        request.resource.data.isUrgent == true;
      allow read, update, delete: if isSuperAdmin(appId);
    }

    match /artifacts/{appId}/public/data/captains/{docId} {
      allow read, create, update, delete: if isSuperAdmin(appId);
    }

    match /artifacts/{appId}/public/data/groups/{docId} {
      allow read: if signedIn();
      allow create: if hasPermission(appId, 'attendance') && canCreateInBranch(appId);
      allow update: if hasPermission(appId, 'attendance') && canChangeInBranch(appId);
      allow delete: if hasPermission(appId, 'attendance') && canDeleteInBranch(appId);
    }

    match /artifacts/{appId}/public/data/activity_logs/{docId} {
      allow read: if hasPermission(appId, 'dashboard') || hasPermission(appId, 'reports');
      allow create: if signedIn() && canCreateInBranch(appId);
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/payments/{docId} {
      allow read: if hasPermission(appId, 'finance') || hasPermission(appId, 'dashboard') ||
        hasPermission(appId, 'reports') ||
        (resource.data.studentId is string && ownsStudent(appId, resource.data.studentId));
      allow create: if hasPermission(appId, 'finance') && canCreateInBranch(appId);
      allow update: if hasPermission(appId, 'finance') && canChangeInBranch(appId);
      allow delete: if hasPermission(appId, 'finance') && canDeleteInBranch(appId);
    }

    match /artifacts/{appId}/public/data/expenses/{docId} {
      allow read: if hasPermission(appId, 'finance') || hasPermission(appId, 'dashboard') || hasPermission(appId, 'reports');
      allow create: if hasPermission(appId, 'finance') && canCreateInBranch(appId);
      allow update: if hasPermission(appId, 'finance') && canChangeInBranch(appId);
      allow delete: if hasPermission(appId, 'finance') && canDeleteInBranch(appId);
    }

    match /artifacts/{appId}/public/data/{collectionName}/{docId} {
      allow read: if
        collectionName in ['debts', 'finance_reasons', 'income_extra', 'products',
          'product_categories', 'inventory_log', 'packages'] &&
        hasPermission(appId, 'finance');
      allow create: if
        collectionName in ['debts', 'finance_reasons', 'income_extra', 'products',
          'product_categories', 'inventory_log', 'packages'] &&
        hasPermission(appId, 'finance') && canCreateInBranch(appId);
      allow update: if
        collectionName in ['debts', 'finance_reasons', 'income_extra', 'products',
          'product_categories', 'inventory_log', 'packages'] &&
        hasPermission(appId, 'finance') && canChangeInBranch(appId);
      allow delete: if
        collectionName in ['debts', 'finance_reasons', 'income_extra', 'products',
          'product_categories', 'inventory_log', 'packages'] &&
        hasPermission(appId, 'finance') && canDeleteInBranch(appId);
    }

    // Product categories are shared between branches and legacy records do not
    // contain a branch field.
    match /artifacts/{appId}/public/data/product_categories/{docId} {
      allow read, create, update, delete: if hasPermission(appId, 'finance');
    }

    match /artifacts/{appId}/public/data/{collectionName}/{docId} {
      allow read: if
        collectionName in ['weights', 'weight_events'] &&
        hasPermission(appId, 'students');
      allow create: if
        collectionName in ['weights', 'weight_events'] &&
        hasPermission(appId, 'students') && canCreateInBranch(appId);
      allow update: if
        collectionName in ['weights', 'weight_events'] &&
        hasPermission(appId, 'students') && canChangeInBranch(appId);
      allow delete: if
        collectionName in ['weights', 'weight_events'] &&
        hasPermission(appId, 'students') && canDeleteInBranch(appId);
    }

    match /artifacts/{appId}/public/data/belt_tests/{docId} {
      allow read: if hasPermission(appId, 'tests') || hasPermission(appId, 'dashboard');
      allow create, update, delete: if hasPermission(appId, 'tests');
    }

    match /artifacts/{appId}/public/data/archive/{docId} {
      allow read: if hasPermission(appId, 'archive') || hasPermission(appId, 'students') || hasPermission(appId, 'finance') || hasPermission(appId, 'reports');
      allow create: if
        (hasPermission(appId, 'archive') || hasPermission(appId, 'students')) &&
        canCreateInBranch(appId);
      allow update: if hasPermission(appId, 'archive') && canChangeInBranch(appId);
      allow delete: if hasPermission(appId, 'archive') && canDeleteInBranch(appId);
    }

    // Historical collections retained for compatibility.
    match /artifacts/{appId}/public/data/events/{docId} {
      allow read: if true;
      allow write: if hasPermission(appId, 'events');
    }

    match /artifacts/{appId}/public/data/fitness_tracking/{docId} {
      allow read, write: if hasPermission(appId, 'weight');
    }
// Additive rules, inserted inside match /databases/{database}/documents.
// Never replace existing rules with this fragment.
function mgDirector() {
 return request.auth != null && request.auth.token.email != null &&
 (request.auth.token.email in ['admin@brave.com','jehad234kawash@yahoo.com'] ||
 (exists(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/users/$(request.auth.token.email)) &&
 get(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/users/$(request.auth.token.email)).data.get('isSuper',false)==true));
}
function mgPermission(permission) {
 return mgDirector() || (request.auth != null && request.auth.token.email != null &&
 exists(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_users/$(request.auth.token.email)) &&
 get(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_users/$(request.auth.token.email)).data.get('active',false)==true &&
 get(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_users/$(request.auth.token.email)).data.get('permissions',[]).hasAny([permission]));
}
function mgEarned(data) {
 let days=data.attendance.values().removeAll([false]).size();
 return math.round(data.salary * (days>26?26:days) / 26 * 100)/100;
}
function mgMonthValid(data) {
 return data.keys().hasOnly(['coachId','month','branch','salary','attendance','paid','lastPayment','closed']) &&
 data.coachId is string && data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') &&
 data.branch in ['شفا بدران','أبو نصير'] && data.salary is number && data.salary>=0 &&
 data.attendance is map && data.attendance.size()<=31 && data.attendance.values().hasOnly([true,false]) &&
 data.paid is number && data.paid>=0 && data.paid<=mgEarned(data);
}
match /artifacts/brave-academy-live-data/public/data/management_users/{email} {
 allow read: if mgDirector() || (request.auth!=null && request.auth.token.email==email);
 allow create,update: if mgDirector() && request.resource.data.keys().hasOnly(['active','permissions']) &&
 request.resource.data.active is bool && request.resource.data.permissions is list &&
 request.resource.data.permissions.hasOnly(['overview','finance','coaches','attendance','payroll','notes','schedule','accounts','inventory','news','reports']);
}
match /artifacts/brave-academy-live-data/public/data/management_coaches/{id} {
 allow read: if mgPermission('coaches') || mgPermission('attendance') || mgPermission('payroll') || mgPermission('notes');
 allow create,update: if mgPermission('coaches') && request.resource.data.keys().hasOnly(['name','salary','branch']) &&
 request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=150 &&
 request.resource.data.salary is number && request.resource.data.salary>=0 && request.resource.data.branch in ['شفا بدران','أبو نصير'];
}
match /artifacts/brave-academy-live-data/public/data/management_months/{id} {
 allow read: if mgPermission('overview') || mgPermission('payroll') || mgPermission('attendance');
 allow create: if mgPermission('payroll') && mgMonthValid(request.resource.data) && id==request.resource.data.coachId+'_'+request.resource.data.month && request.resource.data.paid==0 && request.resource.data.attendance.size()==0;
 allow update: if mgMonthValid(request.resource.data) && (
 (mgPermission('attendance') && resource.data.get('closed',false)==false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance'])) ||
 (mgPermission('payroll') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed']) && request.resource.data.closed==true) ||
 (mgPermission('payroll') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid','lastPayment']) && request.resource.data.paid>resource.data.paid &&
 !exists(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_ledger/$(request.resource.data.lastPayment)) &&
 getAfter(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_ledger/$(request.resource.data.lastPayment)).data.amount==request.resource.data.paid-resource.data.paid &&
 getAfter(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_ledger/$(request.resource.data.lastPayment)).data.coachId==resource.data.coachId &&
 getAfter(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_ledger/$(request.resource.data.lastPayment)).data.month==resource.data.month));
}
match /artifacts/brave-academy-live-data/public/data/management_ledger/{id} {
 allow read: if mgPermission('overview') || mgPermission('finance') || mgPermission('accounts') || mgPermission('reports') || (mgPermission('payroll') && resource.data.kind in ['salary','advance']);
 allow create: if request.resource.data.amount is number && request.resource.data.amount>0 && request.resource.data.title is string &&
 request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.branch in ['شفا بدران','أبو نصير'] && request.resource.data.createdBy==request.auth.token.email && (
 (mgPermission('finance') && request.resource.data.kind in ['income','expense'] && request.resource.data.keys().hasOnly(['kind','title','amount','date','branch','createdBy'])) ||
 (mgPermission('payroll') && request.resource.data.kind in ['salary','advance'] && request.resource.data.keys().hasOnly(['kind','title','amount','date','branch','createdBy','coachId','month']) &&
 getAfter(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_months/$(request.resource.data.coachId+'_'+request.resource.data.month)).data.lastPayment==id &&
 getAfter(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_months/$(request.resource.data.coachId+'_'+request.resource.data.month)).data.paid==
 get(/databases/$(database)/documents/artifacts/brave-academy-live-data/public/data/management_months/$(request.resource.data.coachId+'_'+request.resource.data.month)).data.paid+request.resource.data.amount));
}
match /artifacts/brave-academy-live-data/public/data/management_notes/{id} {
 allow read: if mgPermission('notes');
 allow create: if mgPermission('notes') && request.resource.data.keys().hasOnly(['text','coachId','branch','date','createdBy']) && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=10000 && request.resource.data.createdBy==request.auth.token.email;
}
// Read-only access from the new portal. Existing write grants are untouched.
match /artifacts/brave-academy-live-data/public/data/{name}/{id} {
 allow read: if name in ['students','payments','expenses','income_extra','debts'] && (mgPermission('overview') || mgPermission('finance'));
}

// Access for pages relocated into general management. Captain/user administration remains director-only.
match /artifacts/brave-academy-live-data/public/data/{name}/{id} {
 allow read: if (name in ['students','payments','expenses','income_extra'] && mgPermission('reports')) ||
 (name in ['payments','expenses','income_extra'] && mgPermission('accounts')) ||
 (name in ['products','product_categories','inventory_log'] && mgPermission('inventory'));
 allow create: if ((name=='schedule' && mgPermission('schedule')) || (name=='news' && mgPermission('news')) ||
 (name in ['expenses','income_extra'] && mgPermission('accounts')) ||
 (name in ['products','inventory_log'] && mgPermission('inventory'))) && request.resource.data.branch in ['شفا بدران','أبو نصير','الكل','مشترك','الفرع الرئيسي'];
 allow update: if ((name=='schedule' && mgPermission('schedule')) || (name=='news' && mgPermission('news')) ||
 (name in ['expenses','income_extra'] && mgPermission('accounts')) ||
 (name in ['products','inventory_log'] && mgPermission('inventory'))) && request.resource.data.branch==resource.data.branch;
 allow delete: if (name=='schedule' && mgPermission('schedule')) || (name=='news' && mgPermission('news')) ||
 (name in ['expenses','income_extra'] && mgPermission('accounts')) ||
 (name in ['products','inventory_log'] && mgPermission('inventory'));
 allow create,update,delete: if name=='product_categories' && mgPermission('inventory');
}

  }
}
